# Server-side only — required for AskOptimumSCS live AI
# Local dev: vite plugin reads this. Production: add same name in Vercel → Project → Settings → Environment Variables
ANTHROPIC_API_KEY=your_api_key_here

# Legacy (optional fallback if ANTHROPIC_API_KEY is unset locally)
# VITE_ANTHROPIC_API_KEY=

# Web3Forms for fee quote submissions
VITE_WEB3FORMS_KEY=REPLACE_ME
