# AskOptimumSCS live AI — on Vercel use ANTHROPIC_API_KEY (same value as VITE_ANTHROPIC_API_KEY)
ANTHROPIC_API_KEY=your_api_key_here
VITE_ANTHROPIC_API_KEY=your_api_key_here

# Form submissions (Fee Quote, Book Consultation, Contact) — server-side on Vercel
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
VITE_WEB3FORMS_KEY=your_web3forms_access_key_here

# Optional local dev aliases (also read by /api/submit-form)
# VITE_WEB3FORMS_KEY=
# VITE_ANTHROPIC_API_KEY=

# Careers / talent forms
# VITE_WEB3FORMS_RECRUIT_KEY=
