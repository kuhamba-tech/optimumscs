{
  "version": 2,
  "alias": ["optimumscs.vercel.app", "www.optimumscs.com", "optimumscs.com"],
  "builds": [
    {
      "src": "api/ask-optimum.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/submit-form.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "installCommand": "npm install",
        "buildCommand": "npm run vercel-build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/ask-optimum",
      "dest": "/api/ask-optimum.cjs"
    },
    {
      "src": "/api/submit-form",
      "dest": "/api/submit-form.cjs"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
